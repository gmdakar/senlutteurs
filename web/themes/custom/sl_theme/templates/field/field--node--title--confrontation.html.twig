{#
/**
 * @file
 * Theme override for the node title field for the content type "confrontation".
 *
 * This template replaces the default field template for the title field
 * of confrontation nodes. It outputs <h1> on full node pages and <h2> for
 * teasers or listings. It also removes "vs" from the title text.
 *
 * Available variables:
 * - attributes: HTML attributes for the containing element.
 * - items: List of all the field items. Each item contains:
 *   - attributes: List of HTML attributes for each item.
 *   - content: The field item content.
 * - entity_type: The entity type to which the field belongs.
 * - field_name: The name of the field.
 * - field_type: The type of the field.
 * - label_display: The display settings for the label.
 * - node: The current node entity.
 * - page: TRUE if viewing the full page of the node.
 *
 * @see field.html.twig
 */
#}

{%
  set classes = [
    'field',
    'field--name-' ~ field_name|clean_class,
    'field--type-' ~ field_type|clean_class,
    'field--label-' ~ label_display,
  ]
%}

{% if page %}
  {# Full node page: use h1 #}
  <h1{{ attributes.addClass(classes) }}>
    {% for item in items %}
      {# Remplace " vs " par un span vide avec classe #}
      {{ item.content|render|striptags|replace({' vs ': '<span class="icon-vs"></span>'})|raw }}
    {% endfor %}
  </h1>

{% else %}
  {# Teasers or listings: use h2 #}
  <h2{{ attributes.addClass(classes) }}>
    {%- for item in items -%}
      {{ item.content|render|striptags|replace({' vs ': '<span class="icon-vs"></span>'})|raw }}
    {%- endfor -%}
  </h2>
{% endif %}
