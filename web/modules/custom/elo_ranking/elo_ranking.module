<?php

use Drupal\node\NodeInterface;
use Drupal\views\ViewExecutable;
/**
 * Implements hook_page_attachments().
 */
function elo_ranking_page_attachments(array &$attachments) {

  $route_match = \Drupal::routeMatch();
  $node = $route_match->getParameter('node');

  if (!$node || $node->bundle() !== 'athlete') {
    return;
  }

  $attachments['#attached']['library'][] = 'elo_ranking/elo_chart';

  $attachments['#attached']['drupalSettings']['elo_ranking'] = [
    'nid' => $node->id(),
  ];
}

function elo_ranking_entity_insert($entity) {
  if ($entity instanceof NodeInterface && $entity->bundle() === 'confrontation') {
    
    // On vérifie que le combat a bien une date et des athlètes
    if ($entity->get('field_athlete_1')->isEmpty() || $entity->get('field_athlete_2')->isEmpty()) {
      return;
    }

    $manager = \Drupal::service('elo_ranking.manager');

    // On prépare l'objet $fight comme s'il sortait de la base de données
    $fight = new \stdClass();
    $fight->entity_id = $entity->id();
    $fight->field_athlete_1_target_id = $entity->get('field_athlete_1')->target_id;
    $fight->field_athlete_2_target_id = $entity->get('field_athlete_2')->target_id;
    $fight->field_confrontation_date_value = $entity->get('field_confrontation_date')->value;
    $fight->field_vainqueur_value = $entity->get('field_vainqueur')->value;
    
    // TRÈS IMPORTANT : Le titre est utilisé par SomeTools dans ton service
    $fight->title = $entity->label(); 

    // 1. Calcul et mise à jour des tables techniques (elo_rating / elo_history)
    $manager->processFight($fight); 

    // 2. Synchronisation vers la table node__elo_rating (avec le revision_id que nous avons ajouté)
    $manager->syncEloToNodes(); 
  }
}

/**
 * Implements hook_entity_update().
 * Met à jour le ELO en temps réel lors de la modification d'un combat.
 */
function elo_ranking_entity_update($entity) {
  if (!($entity instanceof NodeInterface) || $entity->bundle() !== 'confrontation') {
    return;
  }

  // Champs déclencheurs d'un recalcul ELO
  $watched_fields = [
    'field_athlete_1',
    'field_athlete_2',
    'field_vainqueur',
    'field_confrontation_date', 
  ];

  $has_changed = FALSE;

  if ($entity->original) {
    foreach ($watched_fields as $field) {
        $new_value = $entity->get($field)->getValue();
        $old_value = $entity->original->get($field)->getValue();

        if ($field === 'field_vainqueur') {
            $new_str = strtolower(trim($new_value[0]['value'] ?? ''));
            $old_str = strtolower(trim($old_value[0]['value'] ?? ''));
            if ($new_str !== $old_str) {
                $has_changed = TRUE;
                break;
            }
        }
        else {
            if ($new_value !== $old_value) {
                $has_changed = TRUE;
                break;
            }
        }
    }
  }
  else {
    // Pas d'original = création déguisée, on recalcule par sécurité
    $has_changed = TRUE;
  }

  if (!$has_changed) {
    return;
  }

  // Même logique que entity_insert
  elo_ranking_entity_insert($entity);
}

function elo_ranking_entity_delete($entity) {
  if ($entity instanceof NodeInterface && $entity->bundle() === 'confrontation') {
    //TROP Lourd, laissons le cron nocturne recalculer
    //\Drupal::service('elo_ranking.manager')->rebuildAll();
