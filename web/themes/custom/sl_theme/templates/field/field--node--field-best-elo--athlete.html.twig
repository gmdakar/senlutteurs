{% for item in items %}

  {% set v_title = '' %}

  {% if element['#object'].field_best_elo.value == '1' %}
    {% set classes = classes|default([])|merge(['is-best_elo']) %}
    {% set v_title = 'Titre non officiel mais attribué de façon consensuelle par la communauté de la lutte'|t %}
  {% endif %}

  <div{{ attributes
        .addClass(classes, 'field__item')
        .setAttribute('title', v_title)
        .setAttribute('alt', v_title)
      }}>

    {% if element['#object'].field_best_elo.value == '1' %}
      <span class="elo-icon elo-best_elo" title="{{ 'Titre non officiel'|t }}"></span>
      <span class="best_elo-text">{{ 'Meilleure performance (actuelle)'|t }}</span>
    {% endif %}

    

  </div>

{% endfor %}