}

function elo_ranking_form_node_athlete_edit_form_alter(&$form, &$form_state, $form_id) {
  if (isset($form['elo_rating'])) {
    $form['elo_rating']['#disabled'] = TRUE;
    //$form['elo_rating']['#access'] = FALSE;
  }
}

/**
 * Implements hook_preprocess_views_view().
 * Alter la rendue charts par défaut, en simulant des liens cliquables sur les lutteurs
 */
function elo_ranking_preprocess_views_view(&$variables) {
  $view = $variables['view'];
  if ($view->id() === 'lutteurs_indexed' && $view->current_display === 'page_2') {
    
    $urls = [];
    foreach ($view->result as $row) {
      $raw_id = $row->nid ?? ($row->search_api_id ?? NULL);
      if ($raw_id) {
        $nid = (is_string($raw_id) && strpos($raw_id, '/') !== FALSE) ? explode('/', $raw_id)[1] : $raw_id;
        $urls[] = \Drupal\Core\Url::fromRoute('entity.node.canonical', ['node' => (int) $nid])->toString();
      }
    }

    // IMPORTANT : Attache au build de la rangée ou du conteneur pour l'AJAX
    $variables['rows']['#attached']['library'][] = 'elo_ranking/elo_view_interact';
    $variables['rows']['#attached']['drupalSettings']['elo_ranking']['ranking_urls'] = $urls;
    
    // Empêche le cache de figer les URLs de la page 1 sur toutes les pages
    $variables['#cache']['max-age'] = 0;
  }
}

/**
 * Implements hook_preprocess_page().
 */
function elo_ranking_preprocess_page(&$variables) {
  // On l'injecte dans le JS sous drupalSettings.elo_ranking.rebuild_active
  $variables['#attached']['drupalSettings']['elo_ranking']['rebuild_active'] = (bool) \Drupal::state()->get('elo_rebuild_in_progress') || (int) \Drupal::state()->get('search_api_is_indexing');
}

/**
 * Implements hook_views_pre_render().
 */
function elo_ranking_views_pre_render(\Drupal\views\ViewExecutable $view) {
  // 1. On cible la vue spécifique
  if ($view->id() == 'lutteurs_indexed') {
    
    // 2. On restreint uniquement aux 3 afficheurs concernés
    $targeted_displays = ['page_2', 'block_1', 'block_2'];
    
    if (in_array($view->current_display, $targeted_displays)) {
      
      // 3. On vérifie le verrou State API posé par ton EloManager
      $is_rebuilding = \Drupal::state()->get('elo_rebuild_in_progress');
      $is_fully_reindexing = (int) \Drupal::state()->get('search_api_is_indexing'); //si search api entrain de TOUT reindexer (+delete index.  cf crontab)

      if ($is_rebuilding || $is_fully_reindexing) {
        // On vide les résultats pour déclencher le "No results behavior" 
        // ou le masquage du bloc.
        $view->result = [];
        $view->total_rows = 0;
        
        // On empêche le cache de se figer sur cet état vide
        $view->element['#cache']['max-age'] = 0;
      }
    }
  }
}